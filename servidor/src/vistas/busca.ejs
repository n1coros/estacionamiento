<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/estilos.css">
    <title>Document</title>
</head>
<body>
    <div class="menu">
    <h1>ESTAC. CONTROL</h1>
     <a href="/">Inicio</a>
    <a href="/ingresos">Ingresos</a>
    <a href="/salidas">Salidas</a>
    <a href="/tarifas">Tarifas</a>
    <a href="">Clientes</a>
    <a href="/busca">Vehículos</a>
</div>
<div class="contenido">
    <h2>Consultas</h2>

    <form action="/busca" method="POST">
        <input type="text" name="patente" placeholder="Patente">
        <input type="submit" value="Buscar">
        <input type="submit" value="Modificar">
        <input type="submit" value="Eliminar">
    </form>

    <h3>Tu ingreso</h3>
        <table>
<tr>
 <th>Patente</th>
<th>Tipo</th>
<th>Plaza</th>
<th>Estado</th>
<th>Entrada</th>
</tr>
<% busca.forEach(i => { %>
<tr>
     <td><%= i.patente %></td>
    <td><%= i.tipo %></td>
    <td><%= i.plaza %></td>
    <td><%= i.estado %></td>
    <td><%= i.fentrada %></td>
</tr>
<% }) %>
    </table>
</body>
</html>